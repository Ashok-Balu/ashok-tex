{
  "name": "ashok-tex-backend",
  "version": "1.0.0",
  "description": "Ashok Tex – REST API",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "test-server": "cross-env NODE_ENV=test nodemon server.js",
    "seed": "cross-env NODE_ENV=development node seed.js --force",
    "seed:safe": "cross-env NODE_ENV=development node seed-safe.js --force",
    "seed:test": "cross-env NODE_ENV=test node seed-safe.js --force",
    "db:backup": "cross-env NODE_ENV=production node scripts/backup.js",
    "db:restore": "cross-env NODE_ENV=production node scripts/restore.js",
    "db:clear": "cross-env NODE_ENV=development node scripts/clear-db.js --force --yes",
    "db:clear:confirm": "cross-env NODE_ENV=development node scripts/clear-db.js --force",
    "db:audit": "cross-env NODE_ENV=development node scripts/db-collections-audit.js",
    "db:cleanup": "cross-env NODE_ENV=development node scripts/db-collections-audit.js --drop --yes"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
