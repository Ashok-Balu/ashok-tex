#!/bin/bash
# ── ENVIRONMENT FILE TEMPLATE ─────────────────────────────────────────────
# Copy this file and rename to:
#   - .env.development (for local development)
#   - .env.test (for testing)
#   - .env.production (for production)
#
# NEVER COMMIT .env FILES - They contain secrets!
# Add to .gitignore ✅

# ── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Configuration ─────────────────────────────────────────────────
# Development: Use local MongoDB
MONGO_URI=mongodb://localhost:27017/ashoktex_dev

# Testing: Use MongoDB Atlas test database
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ashoktex_test?retryWrites=true&w=majority

# Production: Use MongoDB Atlas production database
# ⚠️  DANGEROUS - ONLY for production
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ashoktex_prod?retryWrites=true&w=majority

# ── JWT Configuration ─────────────────────────────────────────────────────
# IMPORTANT: Use different secrets for each environment!
JWT_SECRET=your-super-secret-key-here-min-32-chars-CHANGE-THIS
JWT_EXPIRES_IN=24h

# ── CORS Configuration ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# ── Cloudinary Configuration (Image Upload) ───────────────────────────────
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── AI Advisor Configuration (Optional) ───────────────────────────────────
# When set, Financial Intelligence AI Advisor will generate provider-backed
# insights instead of fallback heuristics.
AI_PROVIDER=groq

# Groq (Recommended with Llama 3.3 70B)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions


